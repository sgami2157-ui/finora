# ===== Publik (boleh terlihat browser) =====
NEXT_PUBLIC_APP_NAME=FINORA
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== RAHASIA — hanya server / Vercel Environment Variables. JANGAN diawali NEXT_PUBLIC_ =====
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive OAuth (Google Cloud Console -> OAuth client type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus sama persis dengan Authorized redirect URI, mis. https://domain-anda.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=

# 32 byte acak (base64) untuk mengenkripsi refresh token Google: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# Macaly Cloud — belum ada API runtime terverifikasi (lihat docs/MACALY.md). Biarkan kosong.
MACALY_API_BASE_URL=
MACALY_API_KEY=

# ===== Secret Edge Function (set dengan `supabase secrets set`, bukan di .env Next.js) =====
# ANTHROPIC_API_KEY=
